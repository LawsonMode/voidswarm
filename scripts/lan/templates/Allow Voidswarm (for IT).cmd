@echo off & setlocal & set "VS_EXE=%~dp0runtime\node.exe" & for %%I in ("%~dp0.") do set "VS_NAME=Voidswarm LAN (%%~fI)"
if not exist "%~dp0app\launch.mjs" (echo(& echo  Unzip the WHOLE folder first: this file must stay in the "Voidswarm LAN" folder, next to app\ and runtime\.& echo(& pause & exit /b 1)
if not exist "%~dp0runtime\node.exe" (echo(& echo  Your antivirus may have removed runtime\node.exe. Check Bitdefender ^> Protection ^> Quarantine, then add an exception ^(START HERE.html^). Or unzip the folder again.& echo(& pause & exit /b 1)
"%SystemRoot%\System32\net.exe" session >nul 2>&1 || (echo(& echo  This file is for IT. It adds a Windows Firewall rule so other devices on the school network can reach Voidswarm, and that needs an administrator: right-click it and choose "Run as administrator" ^(an IT account^). Nothing was changed. Without the rule Voidswarm still works on this PC only.& echo(& pause & exit /b 1)
echo(& echo  Allowing "%VS_EXE%" in: TCP, any local port, the Domain and Private profiles ^(never Public^), rule "%VS_NAME%".& "%SystemRoot%\System32\netsh.exe" advfirewall firewall delete rule name="%VS_NAME%" >nul 2>&1
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoLogo -NoProfile -NonInteractive -Command "$p = $env:VS_EXE; Get-NetFirewallApplicationFilter -PolicyStore PersistentStore | Where-Object { $_.Program -eq $p } | Get-NetFirewallRule | Where-Object { $_.Direction -eq 'Inbound' -and $_.Action -eq 'Block' -and ([string]$_.Profile -match 'Any|Domain|Private') } | ForEach-Object { $r = $_; if ([string]$r.Profile -match 'Any|Public') { $r | Set-NetFirewallRule -Profile Public; Write-Host ('  A Block rule now blocks on Public only: ' + $r.DisplayName) } else { $r | Remove-NetFirewallRule; Write-Host ('  Removed a Block rule: ' + $r.DisplayName) } }"
"%SystemRoot%\System32\netsh.exe" advfirewall firewall add rule name="%VS_NAME%" dir=in action=allow program="%VS_EXE%" protocol=TCP localport=any profile=domain,private enable=yes description="Voidswarm LAN host: players on this network reach the game. Added by Allow Voidswarm (for IT).cmd." || (echo(& echo  netsh could not add the rule ^(see above^). If a Group Policy ignores local firewall rules, add the same program rule in the policy instead ^(FOR SCHOOL IT.txt^).& echo(& pause & exit /b 1)
echo(& echo  Done. Devices on Domain and Private networks can now reach Voidswarm ^(any TCP port, so a port change in Settings needs nothing more^). The Public profile was not changed.& echo  Running this file again replaces the rule. To remove it: netsh advfirewall firewall delete rule name="%VS_NAME%"& echo  If a Group Policy ignores local firewall rules, add the same program rule in the policy instead ^(FOR SCHOOL IT.txt^).& echo(& pause & exit /b 0
