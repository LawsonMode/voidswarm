{
  "name": "voidswarm",
  "version": "0.5.0",
  "private": true,
  "description": "Voidswarm — SubSpace-inspired 32-player neon PvPvE arena shooter (browser client + Node server).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages",
    "start": "tsx src/server/index.ts --serve dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx src/shared/smoke.ts",
    "mod": "tsx src/server/moderation/cli.ts",
    "package:lan": "node scripts/build-lan.mjs",
    "lan": "node scripts/build-lan.mjs --run --"
  },
  "dependencies": {
    "nodemailer": "^10.0.11",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
